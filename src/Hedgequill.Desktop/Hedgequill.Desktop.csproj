<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Hedgequill.Desktop</RootNamespace>
    <AssemblyName>Hedgequill</AssemblyName>
    <!-- Shown by Windows as the file description, e.g. in Task Manager. -->
    <AssemblyTitle>Hedgequill</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\docs\brand\app-icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Views take their project in the constructor. AVLN3001 warns that the runtime XAML loader then can't build them, and the app never uses that loader. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);AVLN3001</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**\*.ttf;Assets\Fonts\**\OFL.txt" />
    <AvaloniaResource Include="..\..\docs\brand\app-icon.ico" Link="Assets\app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hedgequill.Core\Hedgequill.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
