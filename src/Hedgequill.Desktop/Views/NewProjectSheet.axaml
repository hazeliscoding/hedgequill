<!-- The prototype's New project sheet: a title and the folder it goes in. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hedgequill.Desktop.Views.NewProjectSheet">
  <Panel>
    <Border Background="{DynamicResource Scrim}" />
    <Border Classes="sheet" Width="440" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,64,0,0"
            KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="New project">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="heading" Text="New project" AutomationProperties.HeadingLevel="2" />
          <TextBlock Classes="callout" Text="A folder with your title is created inside the location you choose." />
        </StackPanel>
        <StackPanel Spacing="5">
          <TextBlock Classes="field-label" Text="Title" />
          <TextBox x:Name="TitleBox" PlaceholderText="Untitled story" AutomationProperties.Name="Title" />
        </StackPanel>
        <StackPanel Spacing="5">
          <TextBlock Classes="field-label" Text="Location" />
          <Border Classes="field">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Path Classes="icon" Data="M2 4.5A1 1 0 0 1 3 3.5H6L7.5 5H13A1 1 0 0 1 14 6V12A1 1 0 0 1 13 13H3A1 1 0 0 1 2 12Z" />
              <TextBlock x:Name="LocationText" Grid.Column="1" Classes="mono" VerticalAlignment="Center" TextTrimming="PrefixCharacterEllipsis" />
              <Button x:Name="Choose" Grid.Column="2" Classes="small" Content="Choose…" AutomationProperties.Name="Choose location…" />
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
          <Button x:Name="Cancel" Classes="medium" Content="Cancel" />
          <Button x:Name="Create" Classes="medium accent" Content="Create" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
