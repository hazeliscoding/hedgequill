<!-- A notice in the corner: a title, a line of detail, an optional action and a close button. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hedgequill.Desktop.Views.Toast">
  <Border Classes="toast" Width="320">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <StackPanel Spacing="2">
        <TextBlock x:Name="Heading" Classes="toast-title" />
        <TextBlock x:Name="Detail" Classes="callout" />
        <Button x:Name="ActionButton" Classes="small" IsVisible="False" Margin="0,8,0,0" />
      </StackPanel>
      <Button x:Name="Close" Grid.Column="1" Classes="icon" VerticalAlignment="Top" AutomationProperties.Name="Dismiss">
        <Path Data="M3 3L9 9M9 3L3 9" />
      </Button>
    </Grid>
  </Border>
</UserControl>
