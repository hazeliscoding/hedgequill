<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests on Windows: they start the published app and drive its real window through UI Automation with FlaUI.
    CI runs them after the NativeAOT publish. To run them yourself, set HEDGEQUILL_APP to the app's .exe and keep your
    hands off the mouse and keyboard until they finish. Elsewhere they skip.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hedgequill.UiTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hedgequill.Core\Hedgequill.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
