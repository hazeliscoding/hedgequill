<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the Welcome screen to PNG with Avalonia's headless Skia renderer, in light and dark.
    Argument: the output folder, e.g. docs/screenshots
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hedgequill.Screenshots</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hedgequill.Desktop\Hedgequill.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

</Project>
