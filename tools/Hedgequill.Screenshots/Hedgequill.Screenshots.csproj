<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renders the Welcome screen and a workspace to PNG with Avalonia's headless Skia renderer, in light and dark.
    Arguments: the output folder, e.g. docs/screenshots. The demo switch records the README's demo GIFs instead, with ffmpeg; AGENTS.md has the command.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hedgequill.Screenshots</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hedgequill.Desktop\Hedgequill.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

</Project>
