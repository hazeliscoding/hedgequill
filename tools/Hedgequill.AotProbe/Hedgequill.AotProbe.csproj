<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M0's NativeAOT probe: does AvaloniaEdit work in a NativeAOT build? Publish it for a runtime, run it, and read
    its exit code. A console app, so CI can read what it prints on Windows too.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hedgequill.AotProbe</RootNamespace>
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- M2's spell check probe runs the app's own spell checker files, and M7's clipboard probe its own clipboard HTML. -->
  <ItemGroup>
    <Compile Include="..\..\src\Hedgequill.Desktop\Spelling\*.cs" LinkBase="Spelling" />
    <Compile Include="..\..\src\Hedgequill.Core\Text\ClipboardHtml.cs" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
