<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M0's NativeAOT probe: does AvaloniaEdit work in a NativeAOT build? Publish it for a runtime, run it, and read
    its exit code. A console app, so CI can read what it prints on Windows too.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hedgequill.AotProbe</RootNamespace>
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
